<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-3">

            <h2><%= listing.title %></h2>
            </div>
            <div class="card show-card col-6 offset-3 listing-card">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    
                    <%= listing.description %> <br>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                    <%= listing.location %> <br>
                    <%= listing.country %>
                </p>

            </div>
        </div>
        <br>
        
    </div>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class=" edit-btn btn btn-dark col-1 offset-3">Edit</a>
    
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <div class="col-8 offset-3 mb-3">
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">
                    Rating: <span id="rangeValue">3</span>
                </label>

                <input 
                    type="range"
                    class="form-range"
                    min="1"
                    max="5"
                    value="3"
                    id="rating"
                    name="review[rating]"
                    oninput="rangeValue.innerText = this.value"
                >
            </div>
            <div class="mb-3 mt-3">
                <label class="form-label" for="comment">Comment: </label>
                <textarea class="form-control" name="review[comment]" id="comment" cols="30" rows="5" required></textarea>
                <div class="invalid-feedback">Please add some comment for review.</div>
            </div>
            <button class="btn btn-outline-dark" type="submit">Submit</button>
        </form>
        <br><hr><br>
        <h3>All Reviews</h3>
        <!-- <ul>
            <% for(review of listing.reviews) { %>
                <li><%= "⭐".repeat(review.rating) %> <%= "☆".repeat(5 - review.rating) %> <br> <%= review.comment %></li>
            <% } %>
        </ul> -->
        <div class="row">
            <% for(review of listing.reviews) { %>
                <div class="card col-5 mb-3 ms-3">
                    <div class="card-body">
                        <h5 class="card-title">anonymous</h5>
                        <h5 class="card-text"><%= "⭐".repeat(review.rating) %> <%= "☆".repeat(5 - review.rating) %></h5>
                        <p class="card-text"><%= review.comment %></p>
                    </div>
                    <form class="mb-2 mt-1" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-dark btn-sm">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>



    </div>
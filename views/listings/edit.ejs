<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">

        <br><br>
    <h3>Edit your Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" class="form-control" value="<%= listing.title %>" required>
            <div class="invalid-feedback">Title is required</div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>
        
        <div class="mb-3">
            <label for="image preview" class="form-label">Image Preview</label><br>
            <img src="<%= originalImageUrl %>" alt="Previous image preview" >
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image</label>
            <input type="file" name="listing[image]" class="form-control">
        </div>
        
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input type="number" name="listing[price]" class="form-control" value="<%= listing.price %>" required>
                <div class="invalid-feedback">Price is required</div>
            </div>

            <div class="mb-3 col-md-8" >
                <label for="country" class="form-label">Country</label>
                <input type="text" name="listing[country]" class="form-control" value="<%= listing.country %>" required>
                <div class="invalid-feedback">Country is required</div>
            </div>
        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" class="form-control" value="<%= listing.location %>" required>
            <div class="invalid-feedback">Location is required</div>
        </div>
        
        <%
const amenitiesList = [
    { value: "free wifi", label: "Free Wi-Fi", id: "wifi" },
    { value: "complimentary breakfast", label: "Breakfast", id: "breakfast" },
    { value: "beach front", label: "Beach Front", id: "beachfront" },
    { value: "air conditioning", label: "Air Conditioning", id: "ac" },
    { value: "restaurant", label: "Restaurant", id: "restaurant" },
    { value: "free parking", label: "Parking", id: "parking" },
    { value: "swimming pool", label: "Swimming Pool", id: "pool" },
    { value: "room service", label: "Room Service", id: "room_service" },
    { value: "camping", label: "Camping", id: "camping" },
    { value: "boat house", label: "Boat House", id: "boat_house" },
    { value: "fitness center", label: "Fitness Center", id: "gym" },
    { value: "spa", label: "Spa & Wellness", id: "spa" },
    { value: "pet friendly", label: "Pet Friendly", id: "pet_friendly" },
    { value: "mountain view", label: "Mountain View", id: "mountain_view" },
    { value: "arctic view", label: "Arctic View", id: "arctic_view" }
];
%>

<div class="mb-3">
    <label class="form-label">Property Features</label><br>

    <% amenitiesList.forEach(a => { %>
        <input type="checkbox"
                class="btn-check"
                name="listing[amenities][]"
                id="<%= a.id %>"
                value="<%= a.value %>"
                <%= listing.amenities && listing.amenities.includes(a.value) ? "checked" : "" %>>

        <label class="btn btn-outline-primary me-2 mb-2" for="<%= a.id %>">
            <%= a.label %>
        </label>
    <% }) %>
</div>
        
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
        <br><br><br>
    </form>

        </div>
    </div>
</body>
